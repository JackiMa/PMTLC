# ============================================================================
# Top Air Gap Scan
# 扫描范围: 0 - 500 um, 步长 50 um
# 默认事件数: 1e6
# ============================================================================

/run/initialize

# --- Top air gap = 0 um ---
/SiPINLC/geometry/topAirGap 0.00 mm
/run/reinitializeGeometry
/run/beamOn 1000000

# --- Top air gap = 50 um ---
/SiPINLC/geometry/topAirGap 0.05 mm
/run/reinitializeGeometry
/run/beamOn 1000000

# --- Top air gap = 100 um (基准) ---
/SiPINLC/geometry/topAirGap 0.10 mm
/run/reinitializeGeometry
/run/beamOn 1000000

# --- Top air gap = 150 um ---
/SiPINLC/geometry/topAirGap 0.15 mm
/run/reinitializeGeometry
/run/beamOn 1000000

# --- Top air gap = 200 um ---
/SiPINLC/geometry/topAirGap 0.20 mm
/run/reinitializeGeometry
/run/beamOn 1000000

# --- Top air gap = 250 um ---
/SiPINLC/geometry/topAirGap 0.25 mm
/run/reinitializeGeometry
/run/beamOn 1000000

# --- Top air gap = 300 um ---
/SiPINLC/geometry/topAirGap 0.30 mm
/run/reinitializeGeometry
/run/beamOn 1000000

# --- Top air gap = 350 um ---
/SiPINLC/geometry/topAirGap 0.35 mm
/run/reinitializeGeometry
/run/beamOn 1000000

# --- Top air gap = 400 um ---
/SiPINLC/geometry/topAirGap 0.40 mm
/run/reinitializeGeometry
/run/beamOn 1000000

# --- Top air gap = 450 um ---
/SiPINLC/geometry/topAirGap 0.45 mm
/run/reinitializeGeometry
/run/beamOn 1000000

# --- Top air gap = 500 um ---
/SiPINLC/geometry/topAirGap 0.50 mm
/run/reinitializeGeometry
/run/beamOn 1000000


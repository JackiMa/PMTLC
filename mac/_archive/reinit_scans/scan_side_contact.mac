# ============================================================================
# Side Contact Scan (Statistical Equivalent Method)
# 
# 使用统计等效法：分别运行全贴合和全空气层两种配置
# 最终结果按比例加权：ε(p) = p * ε_contact + (1-p) * ε_airgap
#
# 默认事件数: 1e6
# ============================================================================

/run/initialize

# ============================================================================
# Configuration 1: Direct Contact (侧面直接贴合 PTFE，无空气层)
# 对应贴合比例 p = 100%
# ============================================================================
/SiPINLC/geometry/sideContact true
/run/reinitializeGeometry
/run/beamOn 1000000

# ============================================================================
# Configuration 2: Air Gap (侧面有空气间隙)
# 对应贴合比例 p = 0%
# ============================================================================
/SiPINLC/geometry/sideContact false
/run/reinitializeGeometry
/run/beamOn 1000000

# ============================================================================
# 后处理说明：
# 假设 run 0 的收集效率为 ε_contact，run 1 的收集效率为 ε_airgap
# 对于任意贴合比例 p (0 ~ 1)：
#   ε_col(p) = p * ε_contact + (1-p) * ε_airgap
#
# 示例（Python）：
# eps_contact = 0.35  # 从 run 0 获取
# eps_airgap = 0.28   # 从 run 1 获取
# p = 0.5  # 50% 贴合
# eps_50 = p * eps_contact + (1-p) * eps_airgap
# ============================================================================


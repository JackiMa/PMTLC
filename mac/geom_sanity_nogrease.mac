# Geometry sanity check (NO grease): isotropic optical photons from crystal center (g_debug_opticalphoton=true)
# Goal: verify photons can reach sipin_si through the bottom opening (PTFE wrapper should NOT seal bottom)
#
# Notes:
# - Use pdetMode=0 so "reaching Si" is counted and killed (pure geometry arrival).
# - All /SiPINLC/geometry/* must be set BEFORE /run/initialize.

/control/verbose 0
/run/verbose 0
/tracking/verbose 0
/process/optical/verbose 0

/SiPINLC/sipin/pdetMode 0

# No grease, use a thin bottom air gap
/SiPINLC/geometry/greaseThickness 0.0 mm
/SiPINLC/geometry/bottomAirGap 10 um
/SiPINLC/geometry/topAirGap 0.10 mm
/SiPINLC/geometry/sideGap 0.10 mm

/run/initialize
/run/beamOn 10000



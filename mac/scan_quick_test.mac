# ============================================================================
# Quick Test Scan (用于验证扫描功能)
# 事件数较少，用于快速验证
# ============================================================================

/run/initialize

# === Test 1: 基准配置 ===
/SiPINLC/geometry/greaseThickness 0.05 mm
/SiPINLC/geometry/topAirGap 0.10 mm
/SiPINLC/geometry/sideGap 0.10 mm
/run/reinitializeGeometry
/run/beamOn 10000

# === Test 2: Grease 厚度变化 ===
/SiPINLC/geometry/greaseThickness 0.00 mm
/run/reinitializeGeometry
/run/beamOn 10000

/SiPINLC/geometry/greaseThickness 0.10 mm
/run/reinitializeGeometry
/run/beamOn 10000

# === Test 3: 侧面贴合 ===
/SiPINLC/geometry/greaseThickness 0.05 mm
/SiPINLC/geometry/sideContact true
/run/reinitializeGeometry
/run/beamOn 10000

/SiPINLC/geometry/sideContact false
/run/reinitializeGeometry
/run/beamOn 10000

# === Test 4: 顶面空气层 ===
/SiPINLC/geometry/topAirGap 0.00 mm
/run/reinitializeGeometry
/run/beamOn 10000

/SiPINLC/geometry/topAirGap 0.20 mm
/run/reinitializeGeometry
/run/beamOn 10000

/control/shell echo "Quick test completed!"

